# WindLens Environment Configuration

# Elexon BMRS API Base URL
ELEXON_API_BASE=https://data.elexon.co.uk/bmrs/api/v1

# Persistence
DATABASE_PATH=data/windlens.db

# API Settings
REQUEST_TIMEOUT_SECONDS=30.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5

# Procurement Defaults (UK Local Time)
DEFAULT_CUTOFF_HOUR=12
DEFAULT_CUTOFF_MINUTE=0

# Frontend API URL (for Vite build)
VITE_API_BASE_URL=http://localhost:8000/api
